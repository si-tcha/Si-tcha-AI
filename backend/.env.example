# ─── Base de données PostgreSQL ───────────────────────────────────────────────
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="postgresql://postgres.xxxxx:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres"

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=4000

# ─── Authentification JWT ─────────────────────────────────────────────────────
# OBLIGATOIRE : générer avec `openssl rand -base64 32`
JWT_SECRET="your-secure-random-secret-here"

# ─── APIs Externes ───────────────────────────────────────────────────────────
# Clé OpenWeatherMap pour la météo terrain
OPENWEATHER_API_KEY="your-openweathermap-api-key"

# Clé Google Gemini pour l'IA Agronome (Dr. TCHA)
GEMINI_API_KEY="your-gemini-api-key"

# Clé Mistral AI (optionnel)
MISTRAL_API_KEY="your-mistral-api-key"

# Clé AgroMonitoring (NDVI/satellite - optionnel)
AGROMONITORING_API_KEY="your-agromonitoring-api-key"