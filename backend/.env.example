# ─── Base de données PostgreSQL ───────────────────────────────────────────────
# URL de connexion principale (transaction pooler ou direct)
DATABASE_URL="postgresql://user:password@localhost:5432/sitcha_db?schema=public"

# URL de session directe pour les migrations (optionnel)
DIRECT_URL="postgresql://user:password@localhost:5432/sitcha_db?schema=public"

# ─── Serveur ──────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# ─── Sécurité Réseau & Reverse Proxy ──────────────────────────────────────────
# CORS_ORIGIN : Liste blanche des domaines autorisés séparés par des virgules
# OBLIGATOIRE EN PRODUCTION (aucun joker '*' autorisé en production)
CORS_ORIGIN="http://localhost:8081,http://localhost:19006"
# TRUST_PROXY : '1', 'true', ou IP du proxy inverse Nginx / Traefik / Cloudflare
TRUST_PROXY="1"
# BODY_LIMIT : Taille maximale autorisée pour le corps JSON des requêtes (ex: 1mb, 2mb)
BODY_LIMIT="1mb"

# ─── Authentification JWT ─────────────────────────────────────────────────────
# OBLIGATOIRE : générer avec `openssl rand -base64 32`
JWT_SECRET="your-secure-random-secret-here"

# ─── Fournisseur SMS / OTP ───────────────────────────────────────────────────
# Modes supportés : disabled, development, test, nexah
# ATTENTION : 'disabled' par défaut. Aucun SMS réel n'est envoyé sans configuration.
OTP_PROVIDER="disabled"

# Configuration Nexah SMS (désactivé par défaut)
NEXAH_USER="your-nexah-user"
NEXAH_PASSWORD="your-nexah-password"
NEXAH_SENDER_ID="SI-TCHA"
NEXAH_API_URL="https://smsvas.com/bulk/public/index.php/api/v1/sendsms"

# Configuration Africa's Talking SMS (optionnel)
AFRICASTALKING_USERNAME="your-africastalking-username"
AFRICASTALKING_API_KEY="your-africastalking-api-key"

# ─── APIs Externes ───────────────────────────────────────────────────────────
# Clé OpenWeatherMap pour la météo terrain
OPENWEATHER_API_KEY="your-openweathermap-api-key"

# Clé AgroMonitoring (NDVI / météo satellite)
AGROMONITORING_API_KEY="your-agromonitoring-api-key"

# Clé Google Gemini pour l'IA Agronome (Dr. TCHA)
GEMINI_API_KEY="your-gemini-api-key"

# Clé Mistral AI (optionnel)
MISTRAL_API_KEY="your-mistral-api-key"
