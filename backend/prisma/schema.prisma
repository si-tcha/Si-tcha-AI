generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatutAgriculteur {
  EN_ATTENTE
  APPROUVE
  REJETE
}

model Acheteur {
  id                 BigInt                @id @default(autoincrement())
  nom                String?
  nomEntreprise      String                @db.VarChar(100)
  nui                String?               @unique
  secteur_activite   String?
  contact            String                @unique @db.VarChar(50)
  adresse            String?               @db.Text
  preferencesAlertes String?               @db.Text
  pin                String?               @db.VarChar(100)
  pinHash            String?               @db.VarChar(100)
  phoneVerified      Boolean               @default(false)
  isVerified         Boolean               @default(false)
  preferences        Json?
  transactions       TransactionAcheteur[]
  prefinancements    Prefinancement[]
}

model BassinProduction {
  id                    BigInt                 @id @default(autoincrement())
  nom                   String                 @unique @db.VarChar(50)
  region                String                 @db.VarChar(50)
  latitude              Decimal                @db.Decimal(15, 2)
  longitude             Decimal                @db.Decimal(15, 2)
  donneesMeteo          DonneesMeteo[]
  donneesMarche         DonneeMarche[]
  alertesPhyto          AlertePhyto[]
  historiquesProduction HistoriqueProduction[]
  gics                  GIC[]
}

model ProduitAgricole {
  id                    BigInt                 @id @default(autoincrement())
  nom                   String                 @unique @db.VarChar(50)
  categorie             String                 @db.VarChar(50)
  prix                  Decimal?               @db.Decimal(15, 2)
  unite                 String                 @default("kg")
  imageURL              String?                @db.VarChar(250)
  donneesMarche         DonneeMarche[]
  historiquesProduction HistoriqueProduction[]
  recoltesOffres        RecolteOffre[]
}

model DonneesMeteo {
  id                 BigInt            @id @default(autoincrement())
  temperature        Decimal           @db.Decimal(5, 2)
  humidite           Decimal?          @db.Decimal(5, 2)
  pluviometrie       Decimal           @db.Decimal(5, 2)
  probabilitePluie   Decimal?          @db.Decimal(5, 2)
  vitesseVent        Decimal?          @db.Decimal(5, 2)
  description        String?
  timestampMesure    DateTime          @db.Timestamptz
  
  gicId              BigInt?
  gic                GIC?              @relation(fields: [gicId], references: [id])
  bassinProductionId BigInt?
  bassinProduction   BassinProduction? @relation(fields: [bassinProductionId], references: [id])
}

model DonneesSol {
  id                 BigInt   @id @default(autoincrement())
  temperatureSurface Decimal  @db.Decimal(5, 2)
  temperature10cm    Decimal  @db.Decimal(5, 2)
  humidite           Decimal  @db.Decimal(5, 2)
  timestampMesure    DateTime @db.Timestamptz
  
  gicId              BigInt
  gic                GIC      @relation(fields: [gicId], references: [id])
}

model AlerteMeteo {
  id                 BigInt   @id @default(autoincrement())
  messageCourt       String
  detailsTechniques  Json
  type               String
  timestampCreation  DateTime @default(now()) @db.Timestamptz
  
  gicId              BigInt
  gic                GIC      @relation(fields: [gicId], references: [id])
}

model DonneeMarche {
  id                 BigInt           @id @default(autoincrement())
  prixMoyen          Decimal          @db.Decimal(15, 2)
  prixMin            Decimal?         @db.Decimal(15, 2)
  prixMax            Decimal?         @db.Decimal(15, 2)
  rentabilite        Decimal          @db.Decimal(15, 2)
  dateReleve         DateTime         @db.Date
  source             String?
  produitAgricoleId  BigInt
  bassinProductionId BigInt
  produitAgricole    ProduitAgricole  @relation(fields: [produitAgricoleId], references: [id])
  bassinProduction   BassinProduction @relation(fields: [bassinProductionId], references: [id])
}

model AlertePhyto {
  id                 BigInt           @id @default(autoincrement())
  ravageurMaladie    String           @db.VarChar(50)
  protocoleUrgence   String           @db.VarChar(250)
  dateEmission       DateTime         @db.Date
  bassinProductionId BigInt
  bassinProduction   BassinProduction @relation(fields: [bassinProductionId], references: [id])
}

model AgronomeInterne {
  id                    BigInt                @id @default(autoincrement())
  specialite            String                @db.VarChar(50)
  nom                   String                @db.VarChar(50)
  questionsAgronomiques QuestionAgronomique[]
}

model ProgrammeAgricole {
  id                  BigInt   @id @default(autoincrement())
  nom                 String   @db.VarChar(100)
  description         String   @db.Text
  criteresEligibilite String   @db.Text
  dateLimite          DateTime @db.Date
  urlLien             String
}

model HistoriqueProduction {
  id                 BigInt           @id @default(autoincrement())
  anneeCampagne      Int
  quantiteTotale     Decimal          @db.Decimal(15, 2)
  superficieHa       String
  rendementMoyen     String
  prixMoyen          Decimal          @db.Decimal(15, 2)
  timestampMaj       DateTime?        @db.Date
  produitAgricoleId  BigInt
  bassinProductionId BigInt
  produitAgricole    ProduitAgricole  @relation(fields: [produitAgricoleId], references: [id])
  bassinProduction   BassinProduction @relation(fields: [bassinProductionId], references: [id])
}

model GIC {
  id                    BigInt                @id @default(autoincrement())
  nom                   String                @db.VarChar(100)
  logoURL               String                @db.VarChar(250)
  reglementInterieur    String?               @db.Text
  activitesPrincipales  String                @db.Text
  identifiantREF        String                @unique @db.VarChar(50)
  statutLegalisation    String                @db.VarChar(50)
  timestampMaj          DateTime              @db.Date
  bassinProductionId    BigInt
  bassinProduction      BassinProduction      @relation(fields: [bassinProductionId], references: [id])
  polygonId             String?               @unique
  previsionsMeteo       Json?
  recoltesOffres        RecolteOffre[]
  besoins               BesoinGIC[]
  chargesFinancieres    ChargeFinanciere[]
  questionsAgronomiques QuestionAgronomique[]
  echangesB2B           EchangeB2B[]
  prefinancements       Prefinancement[]
  agriculteurs          Agriculteur[]
  donneesMeteo          DonneesMeteo[]
  donneesSol            DonneesSol[]
  alertesMeteo          AlerteMeteo[]
  b2bOfferEntries       B2BOfferEntry[]       @relation("gicB2BEntries")
  parcelEntries         ParcelEntry[]         @relation("gicParcels")
  gicNeedEntries        GicNeedEntry[]        @relation("gicNeeds")
}

model RecolteOffre {
  id                 BigInt                @id @default(autoincrement())
  quantiteEstimee    Decimal               @db.Decimal(15, 2)
  quantiteDisponible Decimal               @db.Decimal(15, 2)
  dateDispoEstimee   DateTime              @db.Date
  maturite           String                @db.VarChar(50)
  photoURL           String?               @db.VarChar(250)
  alerteBaisseEmise  Boolean?
  timestampMaj       DateTime              @db.Date
  produitAgricoleId  BigInt
  gicId              BigInt
  produitAgricole    ProduitAgricole       @relation(fields: [produitAgricoleId], references: [id])
  gic                GIC                   @relation(fields: [gicId], references: [id])
  transactions       TransactionAcheteur[]
  journalCroissance  JournalCroissance?
}

model TransactionAcheteur {
  id             BigInt       @id @default(autoincrement())
  type           String       @db.VarChar(50)
  quantite       Decimal      @db.Decimal(15, 2)
  prixConvenu    Decimal      @db.Decimal(15, 2)
  statut         String       @db.VarChar(50)
  recolteOffreId BigInt
  acheteurId     BigInt
  recolteOffre   RecolteOffre @relation(fields: [recolteOffreId], references: [id])
  acheteur       Acheteur     @relation(fields: [acheteurId], references: [id])
  evaluations    Evaluation[]
}

model BesoinGIC {
  id              BigInt   @id @default(autoincrement())
  categorieBesoin String   @db.VarChar(50)
  description     String   @db.Text
  timestampMaj    DateTime @db.Date
  gicId           BigInt
  gic             GIC      @relation(fields: [gicId], references: [id])
}

model ChargeFinanciere {
  id                 BigInt   @id @default(autoincrement())
  typeCharge         String   @db.VarChar(50)
  montant            Decimal  @db.Decimal(15, 2)
  surfaceHaConcernee Decimal  @db.Decimal(15, 2)
  timestampMaj       DateTime @db.Date
  gicId              BigInt
  gic                GIC      @relation(fields: [gicId], references: [id])
}

model JournalCroissance {
  id                   BigInt       @id @default(autoincrement())
  dateSemis            DateTime     @db.Date
  etatLevee            String       @db.VarChar(50)
  traitementsAppliques String       @db.Text
  timestampMaj         DateTime     @db.Date
  recolteOffreId       BigInt       @unique
  recolteOffre         RecolteOffre @relation(fields: [recolteOffreId], references: [id])
}

model QuestionAgronomique {
  id                BigInt          @id @default(autoincrement())
  questionTexte     String          @db.Text
  mediaUrl          String          @db.VarChar(250)
  statut            String          @db.VarChar(50)
  reponseAgronome   String?         @db.Text
  timestampMaj      DateTime        @db.Date
  agronomeInterneId BigInt
  gicId             BigInt
  agronomeInterne   AgronomeInterne @relation(fields: [agronomeInterneId], references: [id])
  gic               GIC             @relation(fields: [gicId], references: [id])
}

model EchangeB2B {
  id           BigInt   @id @default(autoincrement())
  typeEchange  String   @db.VarChar(50)
  description  String?  @db.Text
  statut       String   @db.VarChar(50)
  timestampMaj DateTime @db.Date
  gicId        BigInt
  gic          GIC      @relation(fields: [gicId], references: [id])
}

model Prefinancement {
  id            BigInt   @id @default(autoincrement())
  type          String   @db.VarChar(50)
  montantValeur Decimal  @db.Decimal(15, 2)
  conditions    String   @db.Text
  gicId         BigInt
  acheteurId    BigInt
  gic           GIC      @relation(fields: [gicId], references: [id])
  acheteur      Acheteur @relation(fields: [acheteurId], references: [id])
}

model Evaluation {
  id                    BigInt              @id @default(autoincrement())
  noteDelai             Int
  notePaiement          Int
  noteQualite           Int
  commentaire           String              @db.Text
  roleAuteur            String              @db.VarChar(50)
  transactionAcheteurId BigInt
  transactionAcheteur   TransactionAcheteur @relation(fields: [transactionAcheteurId], references: [id])
}

model Agriculteur {
  id            BigInt            @id @default(autoincrement())
  nom           String            @db.VarChar(100)
  prenom        String?           @db.VarChar(100)
  contact       String            @unique @db.VarChar(50)
  estLeader     Boolean           @default(false)
  pin           String?           @db.VarChar(100)
  pinHash       String?           @db.VarChar(100)
  phoneVerified Boolean           @default(false)
  isVerified    Boolean           @default(false)
  statut        StatutAgriculteur @default(EN_ATTENTE)
  timestampMaj  DateTime          @db.Date
  gicId         BigInt
  gic           GIC               @relation(fields: [gicId], references: [id])
}

model OtpCode {
  id        BigInt   @id @default(autoincrement())
  phone     String   @unique @db.VarChar(50)
  code      String   @db.VarChar(10)
  expiresAt DateTime
}

model VerificationCode {
  id        String   @id @default(uuid())
  code      String
  contact   String   @unique
  expiresAt DateTime
}

model Admin {
  id       String @id @default(uuid())
  nom      String @unique
  contact  String @unique
  password String
}

model B2BOfferEntry {
  id              String   @id
  title           String   @db.VarChar(200)
  type            String   @db.VarChar(20)
  category        String   @db.VarChar(100)
  priceOrExchange String   @db.VarChar(200)
  gicName         String   @db.VarChar(100)
  location        String   @db.VarChar(200)
  contact         String   @db.VarChar(50)
  createdAt       DateTime @default(now())
  gicId           BigInt
  gic             GIC      @relation("gicB2BEntries", fields: [gicId], references: [id])
}

model ParcelEntry {
  id                    String   @id
  parcelName            String   @db.VarChar(200)
  crop                  String   @db.VarChar(100)
  sowingDate            String   @db.VarChar(50)
  stage                 String   @db.VarChar(50)
  estimatedHarvestDate  String   @db.VarChar(50)
  estimatedVolumeKg     Float
  actualHarvestVolumeKg Float?
  updatedAt             DateTime @default(now())
  gicId                 BigInt
  gic                   GIC      @relation("gicParcels", fields: [gicId], references: [id])
}

model PrefinancingEntry {
  id               String   @id
  gicName          String   @db.VarChar(200)
  buyerName        String   @db.VarChar(200)
  amountFcfa       Float
  inputDescription String   @db.Text
  reservedProduct  String   @db.VarChar(100)
  reservedVolumeKg Float
  status           String   @default("propose") @db.VarChar(50)
  createdAt        DateTime @default(now())
  acheteurId       BigInt?
  gicId            BigInt?
}

model TrustRatingEntry {
  id         String   @id
  targetId   String   @db.VarChar(50)
  targetType String   @db.VarChar(20)
  rating     Int
  comment    String   @db.Text
  authorName String   @db.VarChar(100)
  createdAt  DateTime @default(now())
}

model GicNeedEntry {
  id          String   @id
  category    String   @db.VarChar(50)
  description String   @db.Text
  updatedAt   DateTime @default(now())
  authorRole  String   @default("member") @db.VarChar(50)
  gicId       BigInt
  gic         GIC      @relation("gicNeeds", fields: [gicId], references: [id])
}
