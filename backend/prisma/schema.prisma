generator client {
  provider = "prisma-client-js"
  
}
datasource db {
  provider = "postgresql"
  
}


enum StatutAgriculteur {
  EN_ATTENTE
  APPROUVE
  REJETE
}

enum LangueAgriculteur {
  FR
  EN
}

enum PhaseCulture {
  PREPARATION
  IMPLANTATION
  CROISSANCE
  ENTRETIEN
  RECOLTE
  STOCKAGE
}

enum StatutEtapeCulture {
  A_VENIR
  EN_COURS
  TERMINEE
  ANNULEE
}

enum StatutCycleCulture {
  EN_COURS
  TERMINE
  ANNULE
}

enum NiveauAlerte {
  INFO
  ATTENTION
  URGENT
}

enum StatutNotificationSMS {
  EN_ATTENTE
  ENVOYE
  ECHEC
}

enum StatutParcelle {
  ACTIVE
  ARCHIVEE
}

model Acheteur {
  id                   String                 @id @default(uuid())
  nom                  String    
  adresse              String?             
  nomEntreprise        String 
  nui                  String                 @unique
  secteur_activite     String                 
  contact              String                 @unique
  pin                  String?                // PIN de sécurité, haché
  isVerified           Boolean                @default(false)
  preferences          Json?          
  transactions         TransactionAcheteur[]
  prefinancements      Prefinancement[]
}

model BassinProduction {
  id                   String                 @id @default(uuid())
  nom                  String                 @unique
  region               String                 
  latitude             Decimal                @db.Decimal(15, 2)
  longitude            Decimal                @db.Decimal(15, 2)
  donneesMarche        DonneeMarche[]
  alertesPhyto         AlertePhyto[]
  historiquesProduction HistoriqueProduction[]
  gics                 GIC[]
}

model ProduitAgricole {
  id                   String                 @id @default(uuid())
  nom                  String                 @unique
  categorie            String 
  prix                 Decimal?               @db.Decimal(15, 2)   
  unite                String                 @default("kg")
  imageUrl             String?                  
  donneesMarche        DonneeMarche[]
  historiquesProduction HistoriqueProduction[]
  recoltesOffres       RecolteOffre[]
}

model DonneesMeteo {
  id                 String   @id @default(uuid())
  temperature        Decimal  @db.Decimal(5, 2) // En Celsius
  humidite           Decimal  @db.Decimal(5, 2) // En pourcentage
  pluviometrie       Decimal  @db.Decimal(5, 2) // mm/h
  probabilitePluie   Decimal  @db.Decimal(5, 2) // En pourcentage (POP)
  vitesseVent        Decimal  @db.Decimal(5, 2) // m/s
  description        String   // Ex: "Ciel clair", "Pluie légère"
  timestampMesure    DateTime @db.Timestamptz
  
  gicId              String
  gic                GIC      @relation(fields: [gicId], references: [id])
  parcelleId         String?
  parcelle           Parcelle? @relation(fields: [parcelleId], references: [id], onDelete: SetNull)

  @@index([gicId, timestampMesure])
  @@index([parcelleId, timestampMesure])
}

model DonneesSol {
  id                 String   @id @default(uuid())
  temperatureSurface Decimal  @db.Decimal(5, 2) // En Celsius (t0)
  temperature10cm    Decimal  @db.Decimal(5, 2) // En Celsius (t10)
  humidite           Decimal  @db.Decimal(5, 4) // Volumetric Soil Water (moisture)
  timestampMesure    DateTime @db.Timestamptz
  
  gicId              String
  gic                GIC      @relation(fields: [gicId], references: [id])
  parcelleId         String?
  parcelle           Parcelle? @relation(fields: [parcelleId], references: [id], onDelete: SetNull)

  @@index([gicId, timestampMesure])
  @@index([parcelleId, timestampMesure])
}

// Nouvelle entité : AlerteMeteo (Générée par le CRON pour le Front-end)
model AlerteMeteo {
  id                 String   @id @default(uuid())
  messageCourt       String   // "Risque de pluie dans 2h, reportez l'épandage."
  detailsTechniques  Json     // Les données brutes pour l'agronome
  type               String   // "PLUIE", "SECHERESSE", "GEL"
  cleDeduplication   String?  @unique
  messageCourtEn     String?
  niveau             NiveauAlerte @default(ATTENTION)
  timestampCreation  DateTime @default(now()) @db.Timestamptz
  
  gicId              String
  gic                GIC      @relation(fields: [gicId], references: [id])
  parcelleId         String?
  parcelle           Parcelle? @relation(fields: [parcelleId], references: [id], onDelete: SetNull)
  notifications      NotificationSMS[]

  @@index([gicId, timestampCreation])
  @@index([parcelleId, timestampCreation])
}

model DonneeMarche {
  id                 String           @id @default(uuid())
  prixMoyen          Decimal          @db.Decimal(15, 2)
  prixMin            Decimal?         @db.Decimal(15, 2) // <-- Nouveau champ
  prixMax            Decimal?         @db.Decimal(15, 2) // <-- Nouveau champ
  rentabilite        Decimal          @db.Decimal(15, 2)
  dateReleve         DateTime         @db.Date
  source             String?    
  produitAgricoleId  String
  bassinProductionId String
  produitAgricole    ProduitAgricole  @relation(fields: [produitAgricoleId], references: [id])
  bassinProduction   BassinProduction @relation(fields: [bassinProductionId], references: [id])
}

model AlertePhyto {
  id                 String           @id @default(uuid())
  ravageurMaladie    String           
  protocoleUrgence   String           
  dateEmission       DateTime         @db.Date
  bassinProductionId String
  bassinProduction   BassinProduction @relation(fields: [bassinProductionId], references: [id])
}

model AgronomeInterne {
  id                  String                 @id @default(uuid())
  specialite          String                 
  nom                 String                 
  questionsAgronomiques QuestionAgronomique[]
  gics                GIC[]
}

model ProgrammeAgricole {
  id                  String   @id @default(uuid())
  nom                 String   
  description         String   
  criteresEligibilite String   
  dateLimite          DateTime @db.Date
  urlLien             String   
}

model HistoriqueProduction {
  id                 String           @id @default(uuid())
  anneeCampagne      Int
  quantiteTotale     Decimal          @db.Decimal(15, 2)
  superficieHa       String           
  rendementMoyen     String           
  prixMoyen          Decimal          @db.Decimal(15, 2)
  timestampMaj       DateTime?        @db.Date
  produitAgricoleId  String
  bassinProductionId String
  produitAgricole    ProduitAgricole  @relation(fields: [produitAgricoleId], references: [id])
  bassinProduction   BassinProduction @relation(fields: [bassinProductionId], references: [id])
}

model GIC {
  id                    String                 @id @default(uuid())
  nom                   String                 
  logoURL               String                 
  reglementInterieur    String?                
  activitesPrincipales  String                 
  identifiantREF        String                 @unique
  statutLegalisation    String                 
  timestampMaj          DateTime               @db.Date
  bassinProductionId    String
  bassinProduction      BassinProduction       @relation(fields: [bassinProductionId], references: [id])
  polygonId             String?                @unique // Legacy: migré vers Parcelle.agroMonitoringPolygonId
  previsionsMeteo       Json?    // <-- C'est ici que le CRON va stocker le tableau des 8 jours
  agronomeInterneId     String?
  agronomeInterne       AgronomeInterne?       @relation(fields: [agronomeInterneId], references: [id], onDelete: SetNull)

  // Relations

  recoltesOffres        RecolteOffre[]
  besoins               BesoinGIC[]
  chargesFinancieres    ChargeFinanciere[]
  questionsAgronomiques QuestionAgronomique[]
  echangesB2B           EchangeB2B[]
  prefinancements       Prefinancement[]
  agriculteurs          Agriculteur[]
  donneesMeteo          DonneesMeteo[]
  donneesSol            DonneesSol[]
  alertesMeteo          AlerteMeteo[]
  parcelles             Parcelle[]

  @@index([agronomeInterneId])
}

model RecolteOffre {
  id                 String                 @id @default(uuid())
  quantiteEstimee    Decimal                @db.Decimal(15, 2)
  quantiteDisponible Decimal                @db.Decimal(15, 2)
  dateDispoEstimee   DateTime               @db.Date
  maturite           String                 
  alerteBaisseEmise  Boolean?
  timestampMaj       DateTime               @db.Date
  produitAgricoleId  String
  gicId              String
  produitAgricole    ProduitAgricole        @relation(fields: [produitAgricoleId], references: [id])
  gic                GIC                    @relation(fields: [gicId], references: [id])
  transactions       TransactionAcheteur[]
  journalCroissance  JournalCroissance?
}

model TransactionAcheteur {
  id             String         @id @default(uuid())
  type           String         
  quantite       Decimal        @db.Decimal(15, 2)
  prixConvenu    Decimal        @db.Decimal(15, 2)
  statut         String         
  recolteOffreId String
  acheteurId     String
  recolteOffre   RecolteOffre   @relation(fields: [recolteOffreId], references: [id])
  acheteur       Acheteur       @relation(fields: [acheteurId], references: [id])
  evaluations    Evaluation[]
}

model BesoinGIC {
  id              String   @id @default(uuid())
  categorieBesoin String   
  description     String   
  timestampMaj    DateTime @db.Date
  gicId           String
  gic             GIC      @relation(fields: [gicId], references: [id])
}

model ChargeFinanciere {
  id                 String   @id @default(uuid())
  typeCharge         String   
  montant            Decimal  @db.Decimal(15, 2)
  surfaceHaConcernee Decimal  @db.Decimal(15, 2)
  timestampMaj       DateTime @db.Date
  gicId              String
  gic                GIC      @relation(fields: [gicId], references: [id])
}

model JournalCroissance {
  id                    String       @id @default(uuid())
  dateSemis             DateTime     @db.Date
  etatLevee             String       
  traitementsAppliques  String       
  timestampMaj          DateTime     @db.Date
  recolteOffreId        String       @unique
  recolteOffre          RecolteOffre @relation(fields: [recolteOffreId], references: [id])
}

model QuestionAgronomique {
  id               String          @id @default(uuid())
  questionTexte    String          
  mediaUrl         String          
  statut           String          
  reponseAgronome  String?         
  timestampMaj     DateTime        @db.Date
  agronomeInterneId String
  gicId            String
  agronomeInterne  AgronomeInterne @relation(fields: [agronomeInterneId], references: [id])
  gic              GIC             @relation(fields: [gicId], references: [id])
}

model EchangeB2B {
  id          String    @id @default(uuid())
  typeEchange String    
  description String?   
  statut      String    
  timestampMaj DateTime  @db.Date
  gicId       String
  gic         GIC       @relation(fields: [gicId], references: [id])
}

model Prefinancement {
  id           String   @id @default(uuid())
  type         String   
  montantValeur Decimal  @db.Decimal(15, 2)
  conditions   String   
  gicId        String
  acheteurId   String
  gic          GIC      @relation(fields: [gicId], references: [id])
  acheteur     Acheteur @relation(fields: [acheteurId], references: [id])
}

model Evaluation {
  id                     String              @id @default(uuid())
  noteDelai              Int
  notePaiement           Int
  noteQualite            Int
  commentaire            String              
  roleAuteur             String              
  transactionAcheteurId  String
  transactionAcheteur    TransactionAcheteur @relation(fields: [transactionAcheteurId], references: [id])
}

model Agriculteur {
  id           String            @id @default(uuid())
  nom          String            
  contact      String            @unique
  pin          String?           // PIN de sécurité, haché
  isVerified   Boolean           @default(false)
  estLeader    Boolean           @default(false)
  statut       StatutAgriculteur @default(EN_ATTENTE)
  langue       LangueAgriculteur @default(FR)
  timestampMaj DateTime @db.Date
  gicId        String
  gic          GIC      @relation(fields: [gicId], references: [id])
  parcelles    AgriculteurParcelle[]
  notificationsSMS NotificationSMS[]

  @@unique([gicId, id])
}

model Parcelle {
  id                      String   @id @default(uuid())
  nom                     String
  zone                    String?
  localisation            String?
  surfaceHa               Decimal? @db.Decimal(12, 4)
  latitude                Decimal? @db.Decimal(10, 7)
  longitude               Decimal? @db.Decimal(10, 7)
  geoJson                 Json?    @db.JsonB
  agroMonitoringPolygonId String?  @unique
  statut                  StatutParcelle @default(ACTIVE)
  dateCreation            DateTime @default(now()) @db.Timestamptz
  dateMaj                 DateTime @default(now()) @updatedAt @db.Timestamptz
  gicId                   String
  gic                     GIC      @relation(fields: [gicId], references: [id], onDelete: Cascade)
  agriculteurs            AgriculteurParcelle[]
  cyclesCulture           CycleCulture[]
  donneesMeteo             DonneesMeteo[]
  donneesSol               DonneesSol[]
  previsionsMeteo         PrevisionMeteo[]
  observationsSatellite   ObservationSatellite[]
  alertesMeteo             AlerteMeteo[]

  @@index([gicId, statut])
  @@unique([gicId, id])
}

model AgriculteurParcelle {
  agriculteurId  String
  parcelleId     String
  gicId          String
  fonction       String?
  dateAffectation DateTime @default(now()) @db.Timestamptz
  agriculteur    Agriculteur @relation(fields: [gicId, agriculteurId], references: [gicId, id], onDelete: Cascade)
  parcelle       Parcelle    @relation(fields: [gicId, parcelleId], references: [gicId, id], onDelete: Cascade)

  @@id([agriculteurId, parcelleId])
  @@index([parcelleId])
}

model CycleCulture {
  id           String             @id @default(uuid())
  culture      String
  variete      String?
  surfaceHa    Decimal?           @db.Decimal(12, 4)
  dateSemis    DateTime?          @db.Date
  dateDebut    DateTime?          @db.Date
  dateFin      DateTime?          @db.Date
  statut       StatutCycleCulture @default(EN_COURS)
  dateCreation DateTime           @default(now()) @db.Timestamptz
  parcelleId   String
  parcelle     Parcelle           @relation(fields: [parcelleId], references: [id], onDelete: Cascade)
  etapes       EtapeCycleCulture[]

  @@index([parcelleId, statut])
}

model EtapeCycleCulture {
  id             String             @id @default(uuid())
  ordre          Int
  phase          PhaseCulture
  statut         StatutEtapeCulture @default(A_VENIR)
  dateDebut      DateTime?          @db.Date
  dateFin        DateTime?          @db.Date
  note           String?
  cycleCultureId String
  cycleCulture   CycleCulture       @relation(fields: [cycleCultureId], references: [id], onDelete: Cascade)

  @@unique([cycleCultureId, ordre])
}

model PrevisionMeteo {
  id                 String   @id @default(uuid())
  timestampPrevision DateTime @db.Timestamptz
  temperature        Decimal? @db.Decimal(5, 2)
  humidite           Decimal? @db.Decimal(5, 2)
  pluviometrie       Decimal? @db.Decimal(7, 2)
  probabilitePluie   Decimal? @db.Decimal(5, 4)
  vitesseVent        Decimal? @db.Decimal(5, 2)
  description        String?
  donneesBrutes      Json     @db.JsonB
  dateReception      DateTime @default(now()) @db.Timestamptz
  parcelleId         String
  parcelle           Parcelle @relation(fields: [parcelleId], references: [id], onDelete: Cascade)

  @@unique([parcelleId, timestampPrevision])
}

model ObservationSatellite {
  id                 String   @id @default(uuid())
  dateObservation    DateTime @db.Timestamptz
  satellite          String
  couvertureNuageuse Decimal? @db.Decimal(5, 2)
  ndviMoyen          Decimal? @db.Decimal(7, 5)
  statistiques       Json?    @db.JsonB
  imageNDVIUrl       String?
  imageCouleurUrl    String?
  tuileNDVIUrl       String?
  geoTiffNDVIUrl     String?
  dateReception      DateTime @default(now()) @db.Timestamptz
  parcelleId         String
  parcelle           Parcelle @relation(fields: [parcelleId], references: [id], onDelete: Cascade)

  @@unique([parcelleId, dateObservation, satellite])
}

model NotificationSMS {
  id                    String                @id @default(uuid())
  statut                StatutNotificationSMS @default(EN_ATTENTE)
  identifiantFournisseur String?
  contenu               String
  langue                LangueAgriculteur
  erreur                String?
  dateCreation          DateTime              @default(now()) @db.Timestamptz
  dateEnvoi             DateTime?             @db.Timestamptz
  alerteMeteoId         String?
  alerteMeteo           AlerteMeteo?           @relation(fields: [alerteMeteoId], references: [id], onDelete: SetNull)
  agriculteurId         String
  agriculteur           Agriculteur            @relation(fields: [agriculteurId], references: [id], onDelete: Cascade)

  @@unique([alerteMeteoId, agriculteurId])
  @@index([agriculteurId, dateCreation])
}

model VerificationCode {
  id        String   @id @default(uuid())
  code      String
  contact   String   @unique
  expiresAt DateTime
}

model Admin {
  id          String   @id @default(uuid())
  nom         String   @unique
  contact     String   @unique
  password    String   
}