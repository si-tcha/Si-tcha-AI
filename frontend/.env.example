# ==============================================================================
# Configuration Client Mobile SI-TCHA AI (Expo)
# ==============================================================================

# URL de base de l'API Backend
# Choisissez la valeur appropriée selon votre environnement d'exécution :

# 1. Simulateur iOS ou Navigateur Web (Localhost)
# EXPO_PUBLIC_API_URL=http://localhost:4000/api

# 2. Émulateur Android officiel (Passerelle 10.0.2.2)
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api

# 3. Téléphone physique connecté au même réseau Wi-Fi local
# Remplacez par l'adresse IP locale de votre machine de développement
# EXPO_PUBLIC_API_URL=http://192.168.1.100:4000/api

# 4. Environnement de Préproduction / Production (EAS Build / Déploiement réel)
# EXPO_PUBLIC_API_URL=https://api.si-tcha.org/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
